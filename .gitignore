# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build output ─────────────────────────────────────────────────────────────
dist/
build/

# ── Environment ──────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Secrets (NEVER commit these) ─────────────────────────────────────────────
# Per-network wallet seeds and the deploy record live here. It holds the
# private key material for any wallet the deploy script creates.
.midnight-state.json
# Serialized wallet sync-state cache (also key material).
.midnight-wallet-state/
# Local private state for the contract's witnesses.
*-state/

# ── Logs / coverage ──────────────────────────────────────────────────────────
logs/
*.log
coverage/

# ── OS / IDE ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/settings.json
*.swp

# NOTE: `managed/` is deliberately NOT ignored.
# It is auto-generated by `compact compile`, but this repository commits it so
# that the compiled circuits, ZKIR and proving/verifying keys are inspectable
# without installing the Compact toolchain. Regenerate with `npm run compact`.
